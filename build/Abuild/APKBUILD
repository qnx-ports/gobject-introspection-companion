pkgname=gobject-introspection
pkgver=1.86.0
pkgrel=${pkgrel:-0}
# NOTE: Upgrade only to even-numbered versions (e.g. 1.18.x, 1.20.x)!
pkgdesc="Introspection system for GObject-based libraries"
url="https://gi.readthedocs.io"
arch="all"
license="LGPL-2.0-or-later AND GPL-2.0-or-later AND MIT"
depends_dev="
    glib-dev
    cairo-dev
    libtool
    python3-setuptools
    python3
    "
makedepends="$depends_dev
    bison
    flex
    meson
    pkgconf
    pkgconf-dev
    python3-dev
    "
subpackages="$pkgname-doc $pkgname-dev"
checkdepends="sed"
source="https://download.gnome.org/sources/gobject-introspection/${pkgver%.*}/gobject-introspection-$pkgver.tar.xz"

build() {
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Ddefault_library=both \
        -Db_lto=false \
        -Dtests=false \
        -Dcairo=enabled \
        -Dc_link_args=-Wl,-lm
    meson compile -C build
}

check() {
    meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

dev() {
    amove usr/bin usr/share usr/lib/gobject-introspection
    default_dev
}


options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
a9d2edbe1cea710e10ef1ea8059a45cf5689bace43b5d2a6861809e863a6de7114b4763db8df3916ad6202c9967f48f7997acd0810a86e5e88dea7e0be88b585  gobject-introspection-1.86.0.tar.xz
"
